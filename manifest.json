{
  "manifest_version": 3,
  "name": "ReplayX",
  "version": "1.0.0",
  "description": "Deterministic session recorder and replay tool",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "activeTab", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self';"
  },
  "icons": {
    "16": "favicon.svg",
    "48": "favicon.svg",
    "128": "favicon.svg"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "ReplayX"
  },
  "background": {
    "service_worker": "src/background/service_worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/main.ts"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/interceptor.entry.ts"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
